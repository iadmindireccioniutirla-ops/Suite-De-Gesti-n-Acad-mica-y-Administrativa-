# Optional. Selects the server-side assistant provider: gemini, groq, or cloudflare.
AI_PROVIDER=gemini

# Required only when AI_PROVIDER=gemini.
GEMINI_API_KEY=

# Required only when AI_PROVIDER=groq. Model can be overridden if needed.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Required only when AI_PROVIDER=cloudflare.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# Optional. Defaults to @cf/meta/llama-3.1-8b-instruct.
CLOUDFLARE_MODEL=@cf/meta/llama-3.1-8b-instruct

# Required for the institutional sign-in.
ADMIN_EMAIL=iadmindireccioniutirla@gmail.com
ADMIN_PASSWORD=
AUTH_SESSION_SECRET=

# Optional. Defaults to 3000.
PORT=3000
