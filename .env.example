# Optional. Selects the server-side assistant provider: gemini or groq.
AI_PROVIDER=gemini

# Required only when AI_PROVIDER=gemini.
GEMINI_API_KEY=

# Required only when AI_PROVIDER=groq. Model can be overridden if needed.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Required for the institutional sign-in.
ADMIN_EMAIL=iadmindireccioniutirla@gmail.com
ADMIN_PASSWORD=
AUTH_SESSION_SECRET=

# Optional. Defaults to 3000.
PORT=3000
